{
  "name": "elzoz-photoshop-plugin",
  "version": "1.0.0",
  "scripts": {
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.js",
    "uxp:load": "cd dist && uxp plugin load",
    "uxp:reload": "cd dist && uxp plugin reload",
    "uxp:debug": "cd dist && uxp plugin debug",
    "test:db": "bash scripts/test-db.sh",
    "harness": "webpack --config tests/harness/webpack.harness.js",
    "test-env": "bash scripts/test-env.sh",
    "test:e2e": "bash -c \"source ${ELZOZ_TEST_HOME:-/tmp/elzoz-test}/env && vitest run tests/e2e\"",
    "fixtures": "python3 tests/fixtures-gen/images.py test-artifacts/fixtures/images && node tests/fixtures-gen/generate.mjs && python3 tests/fixtures-gen/verify_psd.py test-artifacts/fixtures/templates",
    "test:ui-e2e": "bash -c \"source ${ELZOZ_TEST_HOME:-/tmp/elzoz-test}/env && PLAYWRIGHT_MODULE=${PLAYWRIGHT_MODULE:-playwright} node tests/harness/e2e-run.js\"",
    "qa:kit": "bash scripts/qa-kit.sh",
    "qa": "bash scripts/qa-all.sh"
  },
  "author": "Elzoz",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.8.7",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/plugin-syntax-class-properties": "^7.10.4",
    "@babel/plugin-transform-react-jsx": "^7.8.3",
    "ag-psd": "^31.0.3",
    "babel-loader": "^8.0.6",
    "clean-webpack-plugin": "^2.0.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "file-loader": "^5.1.0",
    "pg": "^8.23.1",
    "style-loader": "^1.1.3",
    "vitest": "^5.0.3",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "private": true
}
