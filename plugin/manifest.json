{
  "id": "Test-lw40mk",
  "name": "Elzoz",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "requiredPermissions": {
    "allowCodeGenerationFromStrings": false,
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    },
    "network": {
      "domains": []
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": { "default": "Elzoz" },
      "minimumSize": { "width": 240, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 720 },
      "icons": [
        { "width": 32, "height": 32, "path": "icons/icon_D.png", "scale": [1, 2], "theme": ["dark", "darkest"], "species": ["generic"] },
        { "width": 32, "height": 32, "path": "icons/icon_N.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic"] }
      ]
    }
  ],
  "icons": [
    { "width": 32, "height": 32, "path": "icons/icon_D.png", "scale": [1, 2], "theme": ["dark", "darkest"], "species": ["generic"] },
    { "width": 32, "height": 32, "path": "icons/icon_N.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic"] }
  ]
}
